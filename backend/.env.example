NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/samvahak
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used only by: npm run seed:admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Cloudinary (incident image uploads) - from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini API (AI Logistics Copilot) - from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the model. Check https://ai.google.dev/gemini-api/docs/models for the current stable one.
GEMINI_MODEL=gemini-3.1-flash-lite
